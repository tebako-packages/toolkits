#!/usr/bin/env bash
# tools/stage — name a built payload, embed its manifest, repack, and
# fill the sidecar manifest from the recipe.
#
#   tools/stage OUT_DIR PLATFORM [RECIPE]
#
# Produces in dist/:
#   <name>-<version>-<asset>.tfs             the payload image (with
#                                            /__tpkg__/manifest.yaml inside)
#   <name>-<version>-<asset>.manifest.yaml   the sidecar manifest (spec 03),
#                                            carrying the artifact's digest
# where <asset> is the platform's release-asset name (macos-arm64, …) —
# the `tebako publish` CLI's naming grammar.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/lib/common.sh"

OUT="${1:?usage: tools/stage OUT_DIR PLATFORM [RECIPE]}"
PLATFORM="${2:?usage: tools/stage OUT_DIR PLATFORM [RECIPE]}"
RECIPE="${3:-recipes/jq.yml}"
IMAGE="$OUT/payload.tfs"
ROOT="$OUT/root"
[ -f "$IMAGE" ] || { echo "stage: no payload image at $IMAGE (run tools/build first)" >&2; exit 1; }
[ -d "$ROOT" ] || { echo "stage: no staging tree at $ROOT (run tools/build first)" >&2; exit 1; }

NAME="$("$HERE/recipe_query" "$RECIPE" name)"
VERSION="$("$HERE/recipe_query" "$RECIPE" upstream.version)"
# A repack feedstock's source is the upstream artifact it repacked: the
# manifest's src_sha256 pins THAT artifact (the recipe's per-triplet pin).
UP_SHA="$(asset_field "$RECIPE" "$PLATFORM" sha256)"
PLATFORMS="$("$HERE/recipe_query" "$RECIPE" platforms)"   # JSON == YAML flow
EXE_SUFFIX="$(exe_suffix_for "$PLATFORM")"   # the windows image carries /bin/<name>.exe
EXE_NAME="$("$HERE/recipe_query" "$RECIPE" provides.executables.0.name)"
EXE_PATH="$("$HERE/recipe_query" "$RECIPE" provides.executables.0.path)"
CREATED="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
FEEDSTOCK_SHA="$(git rev-parse --verify -q HEAD 2>/dev/null || true)"
[ -n "$FEEDSTOCK_SHA" ] || FEEDSTOCK_SHA="worktree-uncommitted"

fill_manifest() {  # $1 = blob_sha256 to inscribe
  # @@EXE_SUFFIX@@ first: the path/suffix junction would otherwise leave
  # "@@EXE_PATH@@<suffix>" with the suffix already consumed.
  sed -e "s/@@EXE_SUFFIX@@/$EXE_SUFFIX/g" \
      -e "s/@@NAME@@/$NAME/g" \
      -e "s/@@VERSION@@/$VERSION/g" \
      -e "s/@@CREATED@@/$CREATED/g" \
      -e "s/@@UPSTREAM_SHA256@@/$UP_SHA/g" \
      -e "s/@@FEEDSTOCK_SHA@@/$FEEDSTOCK_SHA/g" \
      -e "s/@@BLOB_SHA256@@/$1/g" \
      -e "s/@@EXE_NAME@@/$EXE_NAME/g" \
      -e "s|@@EXE_PATH@@|$EXE_PATH|g" \
      -e "s/@@PLATFORMS@@/$PLATFORMS/g" \
      manifests/payload.yaml
}

check_filled() {  # any placeholder left behind means template drift — fail loudly
  if grep -q '@@[A-Z_]*@@' "$1"; then
    echo "stage: unfilled placeholders in $1:" >&2
    grep '@@[A-Z_]*@@' "$1" >&2
    exit 1
  fi
}

mkdir -p dist "$ROOT/__tpkg__"
# Publish-ready names (the `tebako publish` CLI's grammar): the artifact
# name carries the release-asset platform suffix (macos-arm64, …), the
# registry rows key platforms by triplet.
INFIX="$(asset_infix "$PLATFORM")"
ART="dist/${NAME}-${VERSION}-${INFIX}.tfs"
MAN="dist/${NAME}-${VERSION}-${INFIX}.manifest.yaml"
ZEROS="$(printf '0%.0s' $(seq 64))"

# The EMBEDDED manifest (tier 1, authoritative): the in-image digest can
# never name the image that carries it — the zeros placeholder stands;
# the .sha256 sidecar / the registry pin stays the trust anchor.
fill_manifest "$ZEROS" > "$ROOT/__tpkg__/manifest.yaml"
check_filled "$ROOT/__tpkg__/manifest.yaml"

# repack with the manifest inside (same imager + flags as tools/build)
pack_image "$PLATFORM" "$OUT/tools" "$ROOT" "$IMAGE"

# --- read-back: a broken payload fails THIS leg, never the publish ----
# Re-read the repacked image with the leg's own reader (the same
# verified tfs CLI on every platform): the embedded tier-1 manifest must
# exist and parse as YAML, and every entrypoint it declares must exist
# in the image — proven here, before anything can upload.
# MSYS2_ARG_CONV_EXCL: the VFS paths (/__tpkg__/manifest.yaml, the
# declared /bin/… entrypoints) must reach the native windows reader
# verbatim — msys2 would otherwise rewrite them to host paths. The image
# path itself is relative (out/<name>/<platform>/…), so it needs no
# conversion. Inert on POSIX.
echo "stage: read-back validation of $IMAGE"
READER="$(image_reader "$PLATFORM" "$OUT")"
EMBEDDED="$(MSYS2_ARG_CONV_EXCL='*' "$READER" cat "$IMAGE" /__tpkg__/manifest.yaml)" || {
  echo "stage: read-back FAILED — no /__tpkg__/manifest.yaml in $IMAGE" >&2; exit 1; }
ENTRY_PATHS="$(printf '%s' "$EMBEDDED" | ruby --disable-gems -ryaml -e '
  $stdout.binmode   # ucrt64 ruby text mode would emit \r\n (breaks read -r)
  m = YAML.load(STDIN.read)
  es = (m.dig("provides", "executables") || []) + (m.dig("provides", "entrypoints") || [])
  es.each { |e| puts e["path"] }')" || {
  echo "stage: read-back FAILED — embedded manifest is not valid YAML" >&2; exit 1; }
while IFS= read -r p; do
  p="${p%$'\r'}"   # belt-and-braces with the binmode above
  [ -n "$p" ] || continue
  MSYS2_ARG_CONV_EXCL='*' "$READER" stat "$IMAGE" "$p" >/dev/null || {
    echo "stage: read-back FAILED — declared entrypoint $p missing from $IMAGE" >&2; exit 1; }
  echo "stage: read-back: $p present"
done <<< "$ENTRY_PATHS"

BLOB_SHA="$(sha256_of "$IMAGE")"
fill_manifest "$BLOB_SHA" > "$MAN"
check_filled "$MAN"
cp "$IMAGE" "$ART"

echo "stage: OK"
echo "  artifact: $ART"
echo "  manifest: $MAN"
echo "  sha256:   $BLOB_SHA"

# ------------------------------------------------------------------- sbom
# toolkits#4 (replicating the metanorma#168 feedstock template;
# tebako#1124's standing rules): one CycloneDX 1.6 SBOM PER TOOL PER
# TRIPLET, generated by the pinned CLI's `sbom` verb (tebako#1120) in
# COMPLETE mode — every component carries purl + sha256. Rides the same
# dist artifact as the image; the publish job attaches + signs it.
#
# The input of record is THIS feedstock's hashed closure: the recipe's
# per-triplet upstream asset pin (upstream.assets.<triplet>.sha256 —
# the very digest fetch_verified + cross_check_sums anchored at fetch
# time), rendered to the verb's closure grammar as the one row
# "<name>-<version> <sha256>". A repack leg has no other inventory: the
# verb's degraded in-image mode reads specifications/*.gemspec (a
# rubygems layout a native-binary image never carries — its refusal is
# the named exit 65), so this recipe-derived row is the honest complete
# mode, never a fabricated fallback. --ecosystem generic: a native tool
# maps to pkg:generic/<name>@<version> (CycloneDX application).
SBOM_JSON="dist/${NAME}-${VERSION}-${INFIX}.cdx.json"
rm -f "$SBOM_JSON"
# The leg's pinned tebako CLI (the recipe's tools.tebako block — the
# same pin the publish/dogfood toolchain rides), staged with
# download_tfs's two-anchor discipline. Probe, never assume (the
# registry-validate pattern): the verb exists from the tebako release
# carrying tebako#1120 — an older pin prints "unknown command 'sbom'",
# and the step skips LOUDLY until the pin roll brings a release carrying
# it. (Captured first: both forms exit nonzero, and pipefail would read
# the CLI's own status, never the grep's.)
TEBAKO_REPO="$("$HERE/recipe_query" "$RECIPE" tools.repo)"
TEBAKO_REL="$("$HERE/recipe_query" "$RECIPE" tools.release)"
TEBAKO_SHA="$("$HERE/recipe_query" "$RECIPE" "tools.tebako.sha256.$INFIX")"
download_tebako "$OUT/tools" "$TEBAKO_REPO" "$TEBAKO_REL" "$PLATFORM" "$TEBAKO_SHA"
sbom_probe="$("$(tebako_bin "$OUT/tools")" sbom 2>&1 || true)"
if printf '%s\n' "$sbom_probe" | grep -q "usage: tebako sbom"; then
  CLOSURE_TXT="$OUT/sbom-closure.txt"
  printf '%s %s\n' "$NAME-$VERSION" "$UP_SHA" > "$CLOSURE_TXT"
  # Deterministic (the template's acceptance): the serial derives from
  # the document's identity content and the timestamp reads
  # SOURCE_DATE_EPOCH pinned at the feedstock commit — the product
  # release's own sbom_epoch convention (spec 13 §5a). Two runs on
  # unchanged inputs are byte-identical. Paths stay relative (out/…,
  # dist/…) so the native windows CLI reads them under msys2 (the
  # read-back pattern above).
  SOURCE_DATE_EPOCH="$(git log -1 --format=%ct)" \
    "$(tebako_bin "$OUT/tools")" sbom "$IMAGE" \
      --closure "$CLOSURE_TXT" --ecosystem generic --triplet "$PLATFORM" \
      --out "$SBOM_JSON"
  echo "sbom: $SBOM_JSON"
else
  echo "::notice::the pinned tools predate the sbom verb (tebako#1120) — the leg's SBOM publish activates with the tools pin carrying it (toolkits#4); skipping loudly"
fi
