#!/usr/bin/env bash
# tools/fetch_osv_scanner — fetch the pinned osv-scanner (the SBOM
# smoke's parse proof, toolkits#4), sha256-verified.
#
#   tools/fetch_osv_scanner DESTDIR [INFIX]
#
# DESTDIR receives osv-scanner (chmod +x). INFIX is the release-asset
# platform infix (macos-arm64, linux-gnu-x86_64, …); the default is the
# host's. The pins live in the recipes' sbom.osv_scanner blocks (the
# repo's toolchain pin SSOT). Every recipe must agree on repo/version/
# this infix's pin — the publish consumes ONE smoke tool for all tools,
# so a drifted recipe is a named error here, never a mixed fetch (the
# fetch_publisher doctrine). The pin is cross-checked against the
# release's own osv-scanner_SHA256SUMS (both anchored — the same
# discipline as lib/common.sh's download_tfs). Upstream names assets by
# GOOS_GOARCH; the map covers the POSIX tool platforms — a windows infix
# is a named error (the smoke never runs there).
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/lib/common.sh"

DEST="${1:?usage: fetch_osv_scanner DESTDIR [INFIX]}"
INFIX="${2:-}"

host_infix() {
  case "$(uname -s)-$(uname -m)" in
    Darwin-arm64)    printf '%s' macos-arm64 ;;
    Darwin-x86_64)   printf '%s' macos-x86_64 ;;
    Linux-x86_64)    printf '%s' linux-gnu-x86_64 ;;
    Linux-aarch64)   printf '%s' linux-gnu-arm64 ;;
    *) echo "fetch_osv_scanner: unknown host '$(uname -s)-$(uname -m)' — pass INFIX explicitly" >&2; return 1 ;;
  esac
}
[ -n "$INFIX" ] || INFIX="$(host_infix)"

goos_arch=""
case "$INFIX" in
  macos-arm64)       goos_arch="darwin_arm64" ;;
  macos-x86_64)      goos_arch="darwin_amd64" ;;
  linux-gnu-x86_64)  goos_arch="linux_amd64" ;;
  linux-gnu-arm64)   goos_arch="linux_arm64" ;;
  *) echo "fetch_osv_scanner: no osv-scanner asset map for '$INFIX' — the smoke is POSIX-only" >&2; exit 1 ;;
esac

# All recipes must agree on the smoke tool (repo, version, this infix's
# pin). recipe_query's own refusal names a missing key.
REPO="" VERSION="" WANT=""
for recipe in "$HERE"/../recipes/*.yml; do
  r="$("$HERE/recipe_query" "$recipe" sbom.osv_scanner.repo)"
  v="$("$HERE/recipe_query" "$recipe" sbom.osv_scanner.version)"
  s="$("$HERE/recipe_query" "$recipe" "sbom.osv_scanner.sha256.$INFIX")"
  if [ -z "$REPO" ]; then
    REPO="$r" VERSION="$v" WANT="$s"
  elif [ "$r" != "$REPO" ] || [ "$v" != "$VERSION" ] || [ "$s" != "$WANT" ]; then
    echo "fetch_osv_scanner: sbom.osv_scanner pin drift in $recipe — every recipe must pin the same osv-scanner for $INFIX" >&2
    exit 1
  fi
done

asset="osv-scanner_${goos_arch}"
base="https://github.com/${REPO}/releases/download/v${VERSION}"
mkdir -p "$DEST"
sums="$DEST/osv-scanner_SHA256SUMS.v${VERSION}"
[ -f "$sums" ] || fetch "${base}/osv-scanner_SHA256SUMS" "$sums"
# Cross-check: the recipe pins must match the release's own sums (a
# drifted pin fails loudly, never a silent fetch of the wrong bytes).
got="$(awk -v a="$asset" '$2 == a {print $1}' "$sums")"
[ "$got" = "$WANT" ] || { echo "fetch_osv_scanner: pin mismatch for $asset: recipe=$WANT release=${got:-ABSENT}" >&2; exit 1; }
fetch_verified "${base}/${asset}" "$WANT" "$DEST/osv-scanner"
chmod +x "$DEST/osv-scanner"
echo "fetch_osv_scanner: osv-scanner $VERSION ($INFIX) staged in $DEST"
